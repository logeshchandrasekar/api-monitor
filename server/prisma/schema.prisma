// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  FREE
  PRO
  TEAM
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  plan         Plan     @default(FREE)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  monitors Monitor[]

  @@map("users")
}

enum HttpMethod {
  GET
  POST
  PUT
  PATCH
  DELETE
  HEAD
}

enum MonitorStatus {
  PENDING
  HEALTHY
  DEGRADED
  DOWN
}

model Monitor {
  id                  String        @id @default(uuid())
  userId              String
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String
  description         String?
  url                 String
  method              HttpMethod    @default(GET)
  headersEnc          String?
  bodyEnc             String?
  expectedStatus      Int           @default(200)
  followRedirects     Boolean       @default(true)
  intervalSec         Int
  timeoutMs           Int           @default(10000)
  responseThresholdMs Int           @default(1000)
  failureThreshold    Int           @default(3)
  slowThreshold       Int           @default(3)
  status              MonitorStatus @default(PENDING)
  isPaused            Boolean       @default(false)
  failStreak          Int           @default(0)
  slowStreak          Int           @default(0)
  okStreak            Int           @default(0)
  stateEpoch          Int           @default(0)
  nextCheckAt         DateTime      @db.Timestamptz(3)
  lastCheckedAt       DateTime?     @db.Timestamptz(3)
  lastStatusCode      Int?
  lastResponseTimeMs  Int?
  lastStatusChangeAt  DateTime?     @db.Timestamptz(3)
  tags                String[]
  createdAt           DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @db.Timestamptz(3)

  checks        Check[]
  incidents     Incident[]
  alertRule     AlertRule?
  notifications NotificationLog[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([isPaused, nextCheckAt])
  @@map("monitors")
}

enum CheckTrigger {
  SCHEDULED
  MANUAL
}

enum CheckOutcome {
  SUCCESS
  SLOW
  FAILURE
}

enum FailureType {
  TIMEOUT
  DNS
  CONNECTION
  TLS
  UNEXPECTED_STATUS
  BLOCKED_TARGET
  OTHER
}

model Check {
  id             BigInt       @id @default(autoincrement())
  monitorId      String
  monitor        Monitor      @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  trigger        CheckTrigger
  outcome        CheckOutcome
  failureType    FailureType?
  statusCode     Int?
  responseTimeMs Int?
  errorMessage   String?
  checkedAt      DateTime     @db.Timestamptz(3)

  @@index([monitorId, checkedAt(sort: Desc)])
  @@map("checks")
}

enum IncidentType {
  DOWN
  DEGRADED
}

enum IncidentStatus {
  OPEN
  RESOLVED
}

enum ResolutionReason {
  RECOVERED
  PAUSED
  CONFIG_CHANGED
}

model Incident {
  id           String            @id @default(uuid())
  monitorId    String
  monitor      Monitor           @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  type         IncidentType
  status       IncidentStatus    @default(OPEN)
  reason       String
  failureType  FailureType?
  failedChecks Int               @default(0)
  startedAt    DateTime          @db.Timestamptz(3)
  resolvedAt   DateTime?         @db.Timestamptz(3)
  resolution   ResolutionReason?
  durationSec  Int?
  // "<monitorId>:<type>" while the incident is OPEN, NULL once it is resolved.
  // The unique constraint therefore allows exactly one OPEN incident per monitor and type (DAT-1),
  // while any number of resolved incidents (all with NULL) can exist.
  openKey      String?           @unique

  notifications NotificationLog[]

  @@index([monitorId, startedAt(sort: Desc)])
  @@map("incidents")
}


enum NotificationType {
  DOWN
  DEGRADED
  RECOVERED
  // A "Send test email" click. Not in the PRD patch's enum; it lets the history show test sends too.
  TEST
}

enum NotificationStatus {
  QUEUED
  SENT
  SUPPRESSED
  FAILED
}

// One row per monitor (DAT-2). Created with the defaults when the monitor is created.
model AlertRule {
  id               String   @id @default(uuid())
  monitorId        String   @unique
  monitor          Monitor  @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  notifyOnDown     Boolean  @default(true)
  notifyOnRecovery Boolean  @default(true)
  notifyOnSlow     Boolean  @default(true)
  cooldownMinutes  Int      @default(30)
  // NULL means "the account's own email"
  recipientEmail   String?
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  @@map("alert_rules")
}

// What was (or was not) sent. A QUEUED row is written in the SAME transaction as the incident change (ALT-2);
// the dispatcher sends it after the commit.
model NotificationLog {
  id            String             @id @default(uuid())
  monitorId     String
  monitor       Monitor            @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  incidentId    String?
  incident      Incident?          @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  type          NotificationType
  status        NotificationStatus @default(QUEUED)
  // The address at the moment the row was written (the rule's recipient, or the account email)
  recipient     String
  // When the thing happened (the check's time), not when the row was written: the cooldown compares these
  eventAt       DateTime           @db.Timestamptz(3)
  attempts      Int                @default(0)
  // The dispatcher only picks QUEUED rows whose nextAttemptAt has passed (backoff and claim lease)
  nextAttemptAt DateTime           @default(now()) @db.Timestamptz(3)
  sentAt        DateTime?          @db.Timestamptz(3)
  // A short, safe sentence for a FAILED row. Never the raw SMTP error.
  error         String?
  // Why a row is SUPPRESSED
  note          String?
  createdAt     DateTime           @default(now()) @db.Timestamptz(3)

  // At most one DOWN / DEGRADED / RECOVERED row per incident (TEST rows have no incident)
  @@unique([incidentId, type])
  @@index([monitorId, createdAt(sort: Desc)])
  @@index([status, nextAttemptAt])
  @@map("notification_logs")
}