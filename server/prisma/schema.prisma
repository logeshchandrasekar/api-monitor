// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  FREE
  PRO
  TEAM
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  plan         Plan     @default(FREE)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  monitors Monitor[]

  @@map("users")
}

enum HttpMethod {
  GET
  POST
  PUT
  PATCH
  DELETE
  HEAD
}

enum MonitorStatus {
  PENDING
  HEALTHY
  DEGRADED
  DOWN
}

model Monitor {
  id                  String        @id @default(uuid())
  userId              String
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String
  description         String?
  url                 String
  method              HttpMethod    @default(GET)
  headersEnc          String?
  bodyEnc             String?
  expectedStatus      Int           @default(200)
  followRedirects     Boolean       @default(true)
  intervalSec         Int
  timeoutMs           Int           @default(10000)
  responseThresholdMs Int           @default(1000)
  failureThreshold    Int           @default(3)
  slowThreshold       Int           @default(3)
  status              MonitorStatus @default(PENDING)
  isPaused            Boolean       @default(false)
  failStreak          Int           @default(0)
  slowStreak          Int           @default(0)
  okStreak            Int           @default(0)
  stateEpoch          Int           @default(0)
  nextCheckAt         DateTime      @db.Timestamptz(3)
  lastCheckedAt       DateTime?     @db.Timestamptz(3)
  lastStatusCode      Int?
  lastResponseTimeMs  Int?
  lastStatusChangeAt  DateTime?     @db.Timestamptz(3)
  tags                String[]
  createdAt           DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @db.Timestamptz(3)

  checks              Check[]
  incidents           Incident[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([isPaused, nextCheckAt])
  @@map("monitors")
}

enum CheckTrigger {
  SCHEDULED
  MANUAL
}

enum CheckOutcome {
  SUCCESS
  SLOW
  FAILURE
}

enum FailureType {
  TIMEOUT
  DNS
  CONNECTION
  TLS
  UNEXPECTED_STATUS
  BLOCKED_TARGET
  OTHER
}

model Check {
  id             BigInt       @id @default(autoincrement())
  monitorId      String
  monitor        Monitor      @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  trigger        CheckTrigger
  outcome        CheckOutcome
  failureType    FailureType?
  statusCode     Int?
  responseTimeMs Int?
  errorMessage   String?
  checkedAt      DateTime     @db.Timestamptz(3)

  @@index([monitorId, checkedAt(sort: Desc)])
  @@map("checks")
}

enum IncidentType {
  DOWN
  DEGRADED
}

enum IncidentStatus {
  OPEN
  RESOLVED
}

enum ResolutionReason {
  RECOVERED
  PAUSED
  CONFIG_CHANGED
}

model Incident {
  id           String            @id @default(uuid())
  monitorId    String
  monitor      Monitor           @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  type         IncidentType
  status       IncidentStatus    @default(OPEN)
  reason       String
  failureType  FailureType?
  failedChecks Int               @default(0)
  startedAt    DateTime          @db.Timestamptz(3)
  resolvedAt   DateTime?         @db.Timestamptz(3)
  resolution   ResolutionReason?
  durationSec  Int?
  // "<monitorId>:<type>" while the incident is OPEN, NULL once it is resolved.
  // The unique constraint therefore allows exactly one OPEN incident per monitor and type (DAT-1),
  // while any number of resolved incidents (all with NULL) can exist.
  openKey      String?           @unique

  @@index([monitorId, startedAt(sort: Desc)])
  @@map("incidents")
}