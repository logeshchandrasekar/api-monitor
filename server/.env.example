NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://apimonitor:apimonitor@localhost:5433/api_monitor?schema=public"
CLIENT_URL="http://localhost:5173"
JWT_SECRET=""
LOG_LEVEL=info
ENCRYPTION_KEY=""
ALLOW_PRIVATE_TARGETS=false
# The scheduler runs inside the API process. Set to false to disable it (tests do, or when running a separate worker).
ENABLE_SCHEDULER=true
# How often the scheduler looks for due monitors. 15000 in production; use 2000 locally so 10 s monitors feel right.
SCHEDULER_TICK_MS=15000

# Alert emails (Phase 8). Local development uses Mailpit (docker compose --profile mail up -d mailpit), UI on http://localhost:8025.
SMTP_HOST=localhost
SMTP_PORT=1025
# Leave both blank for no login (Mailpit). A real provider gives you these.
SMTP_USER=
SMTP_PASS=
MAIL_FROM="API Monitor <alerts@apimonitor.local>"
# The dispatcher sends queued alerts from inside the API process. Set to false to turn it off.
ENABLE_DISPATCHER=true
# How often it looks for queued alerts (it also runs straight after every incident).
DISPATCH_TICK_MS=5000
# Wait before the first retry of a failed send; the next two retries wait 4x and 20x this. 30000 = 30 s, 2 min, 10 min.
ALERT_RETRY_BASE_MS=30000
# Phase 9. How many batches of 50 one scheduler tick may claim while monitors are still due (1 = the old limit of 50 per tick).
SCHEDULER_MAX_BATCHES=10
# Deletes checks older than the plan's retention (7 days Free, 30 days Pro), once shortly after boot and then daily.
ENABLE_RETENTION=true