NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://apimonitor:apimonitor@localhost:5433/api_monitor?schema=public"
CLIENT_URL="http://localhost:5173"
JWT_SECRET=""
LOG_LEVEL=info
ENCRYPTION_KEY=""
ALLOW_PRIVATE_TARGETS=false
# The scheduler runs inside the API process. Set to false to disable it (tests do, or when running a separate worker).
ENABLE_SCHEDULER=true
# How often the scheduler looks for due monitors. 15000 in production; use 2000 locally so 10 s monitors feel right.
SCHEDULER_TICK_MS=15000